{
  "info": {
    "name": "Tofimotia API - Venue Booking Platform",
    "description": "Complete API documentation for Tofimotia - A comprehensive venue booking platform that allows users to discover, book, and manage venue reservations. This collection includes all endpoints for authentication, user management, venue operations, and booking functionality.\n\n## Features:\n- User registration and authentication with JWT tokens\n- Role-based access control (USER, VENDOR, ADMIN)\n- Venue management and search capabilities\n- Booking system with availability checking\n- Real-time booking status updates\n\n## Base URL: https://tofimotia-backend.onrender.com\n\n## Authentication:\nMost endpoints require JWT authentication. After login, the token is automatically saved and used for subsequent requests.\n\n## Getting Started:\n1. Register a new user account\n2. Login to get JWT token\n3. Explore venues and create bookings\n4. Manage your bookings and profile",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://tofimotia-backend.onrender.com",
      "type": "string",
      "description": "Base URL for the Tofimotia API"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "venue_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "booking_id",
      "value": "",
      "type": "string"
    }
  ],
